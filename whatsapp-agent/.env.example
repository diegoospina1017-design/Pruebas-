# Meta WhatsApp Cloud API
WA_TOKEN=             # Access token (permanente, de un System User)
WA_PHONE_ID=          # Phone number ID (no es el número de teléfono)
WA_VERIFY_TOKEN=      # Cadena que tú inventas; se repite en el panel de Meta
WA_APP_SECRET=        # App Secret, para validar X-Hub-Signature-256
WA_GRAPH_VERSION=v21.0

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Base de datos de conversaciones (SQLite por defecto)
DB_PATH=conversations.db
