{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statstudio.local/schemas/analysis-spec.schema.json",
  "title": "AnalysisSpec",
  "description": "Reproducible description of one analysis run.",
  "type": "object",
  "required": ["type", "dataset", "params"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "descriptives",
        "ttest_one_sample", "ttest_two_sample", "ttest_paired",
        "chi_square", "proportion_test",
        "anova_one_way",
        "regression_ols", "regression_logistic",
        "timeseries_summary", "timeseries_forecast",
        "control_chart_imr", "control_chart_xbar_r",
        "doe_factorial_design", "doe_factorial_analyze",
        "pca", "kmeans", "hclust"
      ]
    },
    "dataset": {
      "type": "object",
      "required": ["name", "columns", "rows"],
      "properties": {
        "name": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "object"}},
        "rows": {"type": "array", "items": {"type": "object"}},
        "row_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "params": {"type": "object"},
    "selection": {"type": "array", "items": {"type": "string"}},
    "options": {"type": "object"}
  }
}
